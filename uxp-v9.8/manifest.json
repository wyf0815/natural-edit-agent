{
  "manifestVersion": 6,
  "id": "com.local.photoshop.assistant.v8",
  "name": "Natural Edit Agent v9.8",
  "version": "0.9.8",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "startup",
      "addToPluginMenu": true
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "photoshopAssistantV8Panel",
      "label": { "default": "Natural Edit Agent v9.8" },
      "minimumSize": { "width": 360, "height": 540 },
      "maximumSize": { "width": 1200, "height": 1600 },
      "preferredDockedSize": { "width": 450, "height": 850 },
      "preferredFloatingSize": { "width": 500, "height": 900 }
    }
  ],
  "requiredPermissions": {
    "clipboard": "readAndWrite",
    "network": {
      "domains": [
        "http://127.0.0.1:17861",
        "http://localhost:17861",
        "https://dashscope.aliyuncs.com",
        "https://api.moonshot.cn",
        "https://api.deepseek.com",
        "https://open.bigmodel.cn",
        "https://ark.cn-beijing.volces.com",
        "https://api.minimaxi.com",
        "https://api.siliconflow.cn",
        "https://qianfan.baidubce.com",
        "https://api.hunyuan.cloud.tencent.com",
        "https://generativelanguage.googleapis.com",
        "https://api.openai.com"
      ]
    },
    "localFileSystem": "request"
  }
}
